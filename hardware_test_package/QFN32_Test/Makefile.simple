# 简化的Makefile for QFN32测试
# 直接编译，不依赖HAL库

CC = arm-none-eabi-gcc
OBJCOPY = arm-none-eabi-objcopy
SIZE = arm-none-eabi-size

# CPU配置
MCU = -mcpu=cortex-m0plus -mthumb

# 编译选项
CFLAGS = $(MCU)
CFLAGS += -Wall -O2
CFLAGS += -ffunction-sections -fdata-sections
CFLAGS += -ffreestanding -nostdlib
CFLAGS += -std=gnu99

# 链接选项
LDFLAGS = $(MCU)
LDFLAGS += -T ../source/wb32l003.ld
LDFLAGS += -Wl,--gc-sections
LDFLAGS += -Wl,-Map=qfn32_test.map
LDFLAGS += -nostartfiles

# 默认目标
all: qfn32_test.hex

# 编译和链接
qfn32_test.elf: qfn32_test.c ../source/startup_wb32l003.s
	@echo "Building QFN32 test..."
	$(CC) $(CFLAGS) $(LDFLAGS) $^ -o $@
	$(SIZE) $@

# 生成HEX文件
qfn32_test.hex: qfn32_test.elf
	@echo "Generating HEX file..."
	$(OBJCOPY) -O ihex $< $@
	@echo "Success! Created: $@"
	@ls -la $@

# 清理
clean:
	rm -f *.elf *.hex *.map

# 烧录
flash: qfn32_test.hex
	pyocd flash -t wb32l003 $<

.PHONY: all clean flash