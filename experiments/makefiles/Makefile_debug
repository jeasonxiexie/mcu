# Minimal debug test Makefile
TARGET = debug_power_test

# Toolchain
PREFIX = arm-none-eabi-
CC = $(PREFIX)gcc
AS = $(PREFIX)gcc -x assembler-with-cpp
CP = $(PREFIX)objcopy
SZ = $(PREFIX)size
HEX = $(CP) -O ihex
BIN = $(CP) -O binary -S

# MCU
CPU = -mcpu=cortex-m0plus
MCU = $(CPU) -mthumb

# Build directory
BUILD_DIR = build_debug

# Sources - only the test file
C_SOURCES = Core/Src/debug_power_test.c

# Includes
C_INCLUDES = \
-ICore/Inc \
-IDrivers/CMSIS/Device/Westberry/WB32L003/Include \
-IDrivers/CMSIS/Include

# Defines
C_DEFS = \
-DUSE_HAL_DRIVER \
-DWB32L003xx

# Compiler flags
CFLAGS = $(MCU) $(C_DEFS) $(C_INCLUDES) -std=gnu11 -g -O0 -Wall -fdata-sections -ffunction-sections -ffreestanding -nostdlib

# Linker flags - minimal
LDSCRIPT = WB32L003K8Ux_FLASH.ld
LDFLAGS = $(MCU) -T$(LDSCRIPT) -Wl,--gc-sections -static -nostartfiles -nodefaultlibs -nostdlib -Wl,-Map=$(BUILD_DIR)/$(TARGET).map,--cref

# Build all
all: $(BUILD_DIR)/$(TARGET).elf $(BUILD_DIR)/$(TARGET).hex $(BUILD_DIR)/$(TARGET).bin

# Build the application
OBJECTS = $(addprefix $(BUILD_DIR)/,$(notdir $(C_SOURCES:.c=.o)))
vpath %.c $(sort $(dir $(C_SOURCES)))

$(BUILD_DIR)/%.o: %.c Makefile | $(BUILD_DIR) 
	$(CC) -c $(CFLAGS) -Wa,-a,-ad,-alms=$(BUILD_DIR)/$(notdir $(<:.c=.lst)) $< -o $@

$(BUILD_DIR)/$(TARGET).elf: $(OBJECTS) Makefile
	$(CC) $(OBJECTS) $(LDFLAGS) -o $@
	$(SZ) $@

$(BUILD_DIR)/%.hex: $(BUILD_DIR)/%.elf | $(BUILD_DIR)
	$(HEX) $< $@
	
$(BUILD_DIR)/%.bin: $(BUILD_DIR)/%.elf | $(BUILD_DIR)
	$(BIN) $< $@
	
$(BUILD_DIR):
	mkdir $@

# Clean
clean:
	-rm -fR $(BUILD_DIR)

.PHONY: all clean