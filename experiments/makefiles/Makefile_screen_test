# Makefile for WB32L003 Screen Test
# Based on v3.6.0 o3 hardware fix

# Target
TARGET = screen_test

# Debug build?
DEBUG = 1

# C sources for screen test
C_SOURCES = \
Core/Src/screen_test.c \
Core/Src/st7735.c \
Core/Src/early_power.c \
Core/Src/hardware_control.c \
Drivers/WB32L003_HAL_Driver/Src/wb32l003_hal.c \
Drivers/WB32L003_HAL_Driver/Src/wb32l003_hal_gpio.c \
Drivers/WB32L003_HAL_Driver/Src/wb32l003_hal_rcc.c \
Drivers/WB32L003_HAL_Driver/Src/wb32l003_hal_cortex.c \
Drivers/WB32L003_HAL_Driver/Src/system_wb32l003.c

# ASM sources
ASM_SOURCES = startup_wb32l003.s

# CPU
CPU = -mcpu=cortex-m0plus

# FPU (None for Cortex-M0+)
FPU = 

# FLOAT-ABI (soft for Cortex-M0+)
FLOAT-ABI = -mfloat-abi=soft

# MCU
MCU = $(CPU) -mthumb $(FPU) $(FLOAT-ABI)

# AS includes
AS_INCLUDES = 

# AS defines
AS_DEFS = 

# C includes
C_INCLUDES = \
-ICore/Inc \
-IDrivers/WB32L003_HAL_Driver/Inc \
-IDrivers/CMSIS/Include

# C defines
C_DEFS = \
-DUSE_HAL_DRIVER \
-DWB32L003xx

# Optimization
ifeq ($(DEBUG), 1)
OPT = -Og
else
OPT = -Os
endif

# Compile flags
ASFLAGS = $(MCU) $(AS_DEFS) $(AS_INCLUDES) -Wall
CFLAGS = $(MCU) $(C_DEFS) $(C_INCLUDES) $(OPT) -Wall -fdata-sections -ffunction-sections

ifeq ($(DEBUG), 1)
CFLAGS += -g -gdwarf-2
endif

# Generate dependency information
CFLAGS += -MMD -MP -MF"$(@:%.o=%.d)"

# Link script
LDSCRIPT = WB32L003K8Ux_FLASH.ld

# Libraries
LIBS = -L/opt/homebrew/Cellar/arm-none-eabi-gcc/15.1.0/lib/gcc/arm-none-eabi/15.1.0/thumb/v6-m/nofp -L$(BUILD_DIR)/stubs -lgcc -lc -lm -lnosys
LDFLAGS = $(MCU) -T$(LDSCRIPT) $(LIBS) -Wl,-Map=$(BUILD_DIR)/$(TARGET).map,--cref -Wl,--gc-sections -nostartfiles -nodefaultlibs

# Build directory
BUILD_DIR = build_screen_test

# Default action: build all
all: $(BUILD_DIR)/$(TARGET).elf $(BUILD_DIR)/$(TARGET).hex $(BUILD_DIR)/$(TARGET).bin

# List of objects
OBJECTS = $(addprefix $(BUILD_DIR)/,$(notdir $(C_SOURCES:.c=.o)))
vpath %.c $(sort $(dir $(C_SOURCES)))
# List of ASM program objects
OBJECTS += $(addprefix $(BUILD_DIR)/,$(notdir $(ASM_SOURCES:.s=.o)))
vpath %.s $(sort $(dir $(ASM_SOURCES)))

$(BUILD_DIR)/%.o: %.c Makefile_screen_test | $(BUILD_DIR) 
	arm-none-eabi-gcc -c $(CFLAGS) -Wa,-a,-ad,-alms=$(BUILD_DIR)/$(notdir $(<:.c=.lst)) $< -o $@

$(BUILD_DIR)/%.o: %.s Makefile_screen_test | $(BUILD_DIR)
	arm-none-eabi-as $(ASFLAGS) $< -o $@

$(BUILD_DIR)/$(TARGET).elf: $(OBJECTS) Makefile_screen_test
	arm-none-eabi-gcc $(OBJECTS) $(LDFLAGS) -o $@
	arm-none-eabi-size $@

$(BUILD_DIR)/%.hex: $(BUILD_DIR)/%.elf | $(BUILD_DIR)
	arm-none-eabi-objcopy -O ihex $< $@
	
$(BUILD_DIR)/%.bin: $(BUILD_DIR)/%.elf | $(BUILD_DIR)
	arm-none-eabi-objcopy -O binary -S $< $@	
	
$(BUILD_DIR):
	mkdir $@		

# Clean up
clean:
	-rm -fR $(BUILD_DIR)

# Phony targets
.PHONY: all clean

# Dependencies
-include $(wildcard $(BUILD_DIR)/*.d)