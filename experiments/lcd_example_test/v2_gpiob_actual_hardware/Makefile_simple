# Makefile for simple test program
TARGET = simple_test

# Tools
CC = arm-none-eabi-gcc
AS = arm-none-eabi-gcc -x assembler-with-cpp
CP = arm-none-eabi-objcopy
SZ = arm-none-eabi-size
HEX = $(CP) -O ihex
BIN = $(CP) -O binary -S

# MCU settings
CPU = -mcpu=cortex-m0plus
MCU = $(CPU) -mthumb

# Paths
HAL_DIR = ../../../WB32L003_Project/Libraries/WB32L003_HAL_Driver
CMSIS_DIR = ../../../WB32L003_Project/Libraries/CMSIS

# Source files
C_SOURCES = \
simple_test.c \
simple_uart.c \
early_power.c \
stubs.c \
system_wb32l003.c \
$(HAL_DIR)/Src/wb32l003_hal.c \
$(HAL_DIR)/Src/wb32l003_hal_gpio.c \
$(HAL_DIR)/Src/wb32l003_hal_rcc.c \
$(HAL_DIR)/Src/wb32l003_hal_cortex.c \
$(HAL_DIR)/Src/wb32l003_hal_flash.c \
$(HAL_DIR)/Src/wb32l003_hal_pwr.c

ASM_SOURCES = startup_wb32l003.s

# Include paths
C_INCLUDES = \
-I. \
-I$(HAL_DIR)/Inc \
-I$(CMSIS_DIR)/Include \
-I$(CMSIS_DIR)/Device/Westberry/WB32L003/Include

# Compile flags
CFLAGS = $(MCU) $(C_INCLUDES) -Wall -fdata-sections -ffunction-sections
CFLAGS += -Os -g
CFLAGS += -D WB32L003xx

# Linker flags
LDSCRIPT = wb32l003_flash.ld
LDFLAGS = $(MCU) -specs=nano.specs -T$(LDSCRIPT) -Wl,--gc-sections
LDFLAGS += -Wl,-Map=$(TARGET).map,--cref -Wl,--no-warn-mismatch

# Build rules
all: $(TARGET).hex $(TARGET).bin
	$(SZ) $(TARGET).elf
	@echo "Build complete: $(TARGET).hex"

# Compile C sources
%.o: %.c Makefile_simple
	$(CC) -c $(CFLAGS) $< -o $@

# Compile ASM sources
%.o: %.s Makefile_simple
	$(AS) -c $(CFLAGS) $< -o $@

# Link
$(TARGET).elf: $(C_SOURCES:.c=.o) $(ASM_SOURCES:.s=.o)
	$(CC) $(C_SOURCES:.c=.o) $(ASM_SOURCES:.s=.o) $(LDFLAGS) -o $@

# Generate hex and bin
$(TARGET).hex: $(TARGET).elf
	$(HEX) $< $@

$(TARGET).bin: $(TARGET).elf
	$(BIN) $< $@

# Clean
clean:
	rm -f *.o *.elf *.map *.hex *.bin
	rm -f $(HAL_DIR)/Src/*.o

.PHONY: all clean