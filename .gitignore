# Build outputs
build/
*.o
*.d
*.elf
*.map
*.lst
*.hex
*.bin
*.srec

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~
.DS_Store

# IDE specific files
.vscode/
.idea/
*.ioc
*.eww
*.ewp
*.ewd
*.uvguix.*
*.uvoptx
*.uvprojx

# Debug files
*.log
*.tlog
*.idb
*.pdb

# Backup files
*.bak
*.backup
*.old

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Tool downloads
tools/*.tar.gz
tools/*.tar.bz2
tools/*.zip

# Delivery archives (keep only the latest)
delivery_package*.zip
!delivery_package_v2.0.zip

# Large binary files that can be regenerated
WB32L003_Project/build/

# OS generated files
Thumbs.db
.Spotlight-V100
.Trashes

# Project specific ignores
# Keep firmware in delivery folder but ignore build artifacts
!delivery/v2.0/firmware.bin
!delivery/v2.0/firmware.hex

# Claude AI assistant files
.claude/

# Empty tools directory
tools/

# Build directories
WB32L003_Project/build_*/
WB32L003_Project/minimal_build/
WB32L003_Project/compile_temp/

# Compressed archives
*.tar.gz
*.tar.bz2
*.zip

# Experiment and archive directories (tracked but not their build outputs)
experiments/builds/**/build/
experiments/builds/**/*.o
experiments/builds/**/*.d
experiments/builds/**/*.elf
experiments/builds/**/*.map
experiments/builds/**/*.lst

# Vendor package build outputs
vendor/**/build/
vendor/**/*.o
vendor/**/*.d