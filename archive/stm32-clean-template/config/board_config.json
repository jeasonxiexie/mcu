{
  "project": {
    "name": "stm32_project",
    "version": "1.0.0",
    "description": "STM32 Clean Architecture Project"
  },
  "mcu": {
    "family": "WB32L003",
    "model": "WB32L003K8U6",
    "core": "Cortex-M0+",
    "flash_size": "64KB",
    "ram_size": "8KB",
    "package": "QFN32"
  },
  "clock": {
    "source": "HSI",
    "system_clock": "32MHz",
    "ahb_prescaler": 1,
    "apb1_prescaler": 1,
    "apb2_prescaler": 1
  },
  "memory": {
    "flash_start": "0x08000000",
    "ram_start": "0x20000000",
    "stack_size": "0x400",
    "heap_size": "0x200"
  },
  "toolchain": {
    "compiler": "arm-none-eabi-gcc",
    "linker_script": "STM32F0xx_FLASH.ld",
    "optimization": "-Os"
  }
}